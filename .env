# ─────────────────────────────────────────────────────────────
# Screenshoti — environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# ─────────────────────────────────────────────────────────────

# ── App identity ──────────────────────────────────────────────
APP_NAME=Screenshoti
APP_ENV=development
APP_VERSION=1.0.0
APP_BUILD=1

# ── Feature flags ────────────────────────────────────────────
FEATURE_CLOUD_SYNC=false
FEATURE_OCR=true
FEATURE_SMART_CATEGORIES=true
FEATURE_PIN_LOCK=true
FEATURE_DEMO_SEED=true

# ── Demo / showcase ──────────────────────────────────────────
# Set to "true" to seed demo screenshots on first launch
DEMO_MODE=true
# How many synthetic demo screenshots to generate
DEMO_SCREENSHOT_COUNT=24

# ── Sync / backup (optional – leave blank to disable) ────────
# Secret used for XOR encoding the backup payload.
# Change this to any long random string in production.
SYNC_SECRET=screenshoti-demo-secret-change-in-prod

# ── Analytics (optional) ─────────────────────────────────────
# Set to "true" to print analytics events to Metro console
ANALYTICS_DEBUG=true

# ── Sentry (optional — leave blank to skip) ──────────────────
SENTRY_DSN=

# ── API base (future cloud backend) ──────────────────────────
API_BASE_URL=https://api.screenshoti.app
API_TIMEOUT_MS=10000
