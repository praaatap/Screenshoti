# ─────────────────────────────────────────────────────────────
# Screenshoti — environment variable template
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

APP_NAME=Screenshoti
APP_ENV=development
APP_VERSION=1.0.0
APP_BUILD=1

FEATURE_CLOUD_SYNC=false
FEATURE_OCR=true
FEATURE_SMART_CATEGORIES=true
FEATURE_PIN_LOCK=true
FEATURE_DEMO_SEED=true

DEMO_MODE=true
DEMO_SCREENSHOT_COUNT=24

SYNC_SECRET=change-this-to-a-long-random-secret

ANALYTICS_DEBUG=false

SENTRY_DSN=

API_BASE_URL=https://api.screenshoti.app
API_TIMEOUT_MS=10000
